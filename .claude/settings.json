{
  "permissions": {
    "allow": [
      "Bash(pytest:*)",
      "Bash(python3 -m pytest:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./*.db)",
      "Read(./.pytest_cache/**)",
      "Read(./**/__pycache__/**)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          { "type": "command", "command": "python3 -m pytest -q -x 2>&1 | tail -5" }
        ]
      }
    ]
  }
}
